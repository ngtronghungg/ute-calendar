# ==============================================================================
# UTE-Calendar - Cấu hình biến môi trường
# Sao chép tệp này thành .env khi chạy máy cá nhân hoặc cấu hình trên Vercel
# Tuyệt đối không commit tệp chứa thông tin thật lên GitHub
# ==============================================================================

# Khóa bảo vệ phiên đăng nhập (chuỗi ngẫu nhiên tối thiểu 32 ký tự)
SESSION_SECRET=your_random_32_character_session_secret_here

# Upstash Redis REST (kết nối cơ sở dữ liệu trên Vercel / serverless)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Email liên hệ hỗ trợ hoặc tiếp nhận yêu cầu xoá dữ liệu
CONTACT_EMAIL=

# Đường dẫn kho mã nguồn dự án trên GitHub
GITHUB_REPO_URL=https://github.com/ngtronghungg/ute-calendar

# Đường dẫn bảng tính mẫu tự động cập nhật lịch học
AUTO_SYNC_TEMPLATE_URL=

# Thư mục lưu dữ liệu cục bộ khi chạy trên máy (mặc định data)
DATA_DIR=data

# Cổng mạng chạy máy chủ cục bộ (mặc định 5000)
PORT=5000
